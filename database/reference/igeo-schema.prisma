generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  contentMentionReads ContentMentionRead[]
  contentDeliveries ContentDeliveryJob[]
  id                     String                  @id @default(uuid()) @db.Uuid
  title                  String                  @map("title")
  status                 String                  @default("ACTIVE")
  names                  String[]                @map("names")
  domains                String[]
  knowledgeSources       String[]                @default([]) @map("knowledge_sources")
  sitemapUrl             String?                 @map("sitemap_url")
  caseStudiesSourceUrl   String?                 @map("case_studies_source_url")
  caseStudies            Json                    @default("[]") @map("case_studies")
  postGuidelines         Json?                   @map("post_guidelines")
  // Private project-management document; excluded from general account responses.
  projectData            Json                    @default("{}") @map("project_data")
  skipPostImages         Boolean                 @default(false) @map("skip_post_images")
  generatePostsOnRecommendation Boolean          @default(true) @map("generate_posts_on_recommendation")
  logo                   String?
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  isUnderAgency          Boolean                 @default(false) @map("is_under_agency")
  isDemo                 Boolean                 @default(false) @map("is_demo")
  parentAccountId        String?                 @map("parent_account_id") @db.Uuid
  parentAccount          Account?                @relation("AgencyChildren", fields: [parentAccountId], references: [id], onDelete: Cascade)
  childAccounts          Account[]               @relation("AgencyChildren")

  // Workspaces. A workspace IS an Account whose projectAccountId points at its
  // project, so all ~43 account-scoped tables (prompts, scans, recommendations,
  // posts) work unchanged and each workspace gets its own of everything.
  //
  // Deliberately a SEPARATE relation from parentAccountId above:
  //   - parentAccountId is the AGENCY hierarchy, is onDelete: Cascade, and grants
  //     the AccountActiveGuard subscription bypass via isUnderAgency. Overloading
  //     it would silently give every workspace that bypass.
  //   - Cascade here is correct and intended: deleting a project must take its
  //     workspaces with it, since a workspace cannot exist without its project.
  //
  // A workspace's `title` holds ONLY its own name ("Marketing"); the full label
  // "Serrala – Marketing" is composed for display, so renaming a project renames
  // all of its workspaces for free.
  //
  // Limits live on the PROJECT's AccountSettings and are pooled across it and all
  // its workspaces — a workspace's own AccountSettings carries no limits.
  projectAccountId       String?                 @map("project_account_id") @db.Uuid
  projectAccount         Account?                @relation("ProjectWorkspaces", fields: [projectAccountId], references: [id], onDelete: Cascade)
  workspaces             Account[]               @relation("ProjectWorkspaces")

  @@index([projectAccountId])
  about                  String?                 @map("about")
  industryCategory       String?                 @map("industry_category")
  subIndustryCategory    String?                 @map("sub_industry_category")
  companyCountry         String?                 @map("company_country") @db.VarChar(2)
  reportingExcluded      Boolean                 @default(false) @map("reporting_excluded")
  language               String?                 @map("language")
  keyFeatures            String[]                @map("key_features")
  toneOfVoice            String[]                @map("tone_of_voice")
  values                 String[]                @map("values")
  personality            String[]                @map("personality")
  targetAudience         String[]                @map("target_audience")
  accountSettings        AccountSettings?
  competitors            Competitor[]
  Page                   Page[]
  prompts                Prompt[]
  recommendations        Recommendation[]
  recommendationRuns     RecommendationRun[]
  recommendationSources  RecommendationEvidenceSource[]
  scans                  Scan[]
  tasks                  Task[]
  topics                 Topic[]
  trackedRecommendations TrackedRecommendation[]
  UserAccount            UserAccount[]
  AccountSubscription    AccountSubscription[]
  FeatureRequest         FeatureRequest[]
  post                   post[]
  AsyncJob               AsyncJob[]
  PromptResponse PromptResponse[]
  ContentSource          ContentSource[]
  EmbeddingChunk         EmbeddingChunk[]
  tags                   Tag[]
  audiences              Audience[]
  uiPageCache            UiPageCache[]
  socials                Json?                   @map("socials")
  brandColors            Json?                   @map("brand_colors")
  makeDupScans           Int                     @default(0) @map("make_dup_scans")
  mcpApiKeys             McpApiKey[]
  mcpAuditLogs           McpAuditLog[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens      OAuthAccessToken[]
  sentNotifications      SentNotification[]
  articlePublications    ArticlePublication[]
  articleTokenTransactions ArticleTokenTransaction[]
  articleMarketplaceSourceMatchesCache ArticleMarketplaceSourceMatchesCache?
  subscriptionCancellationFeedback SubscriptionCancellationFeedback[]
  pageScans              PageScan[]
  pageScanResults        PageScanResult[]
  slackConnection        SlackConnection?
  slackAuditLogs         SlackAuditLog[]
  zernioProfiles         ZernioProfile[]
  zernioSocialConnections ZernioSocialConnection[]
  zernioWebhookEvents    ZernioWebhookEvent[]
  linkedInEngagements    LinkedInEngagement[]
  socialEngagements      SocialEngagement[]
  contentIdeas           ContentIdea[]
  aiDraftSessions        AiDraftSession[]
  notificationPreferences NotificationPreference[]
  contentNotifications   ContentNotification[]
  aiAssistantSessions    AiAssistantSession[]
  appSumoLicenses        AppSumoLicense[]
  featureFlags           AccountFeatureFlag[]
  socialProfileGroups    SocialProfileGroup[]
  socialProfileGroupMembers SocialProfileGroupMember[]
  accountTeamRoles       AccountTeamRole[]
  gscKeywordSyncs        GscKeywordSync[]
  gscKeywordDays         GscKeywordDay[]

  // No-website onboarding: 'HAS_DOMAIN' (default/legacy) | 'NEEDS_WEBSITE'
  onboardingPath         String?                 @default("HAS_DOMAIN") @map("onboarding_path")
  generatedWebsite       GeneratedWebsite?
  domainOrders           DomainOrder[]
  websiteEditSessions    WebsiteEditSession[]

  @@map("accounts")
}

// Site-scoped durable Search Console history. A property change never mixes
// observations, and account deletion removes its history through the day rows.
/// Reporting facts contain no names, emails, domains or billing addresses.
/// Deliberately independent of source foreign keys so source deletion preserves totals.
model DataCenterRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequence   BigInt   @unique @default(autoincrement())
  key        String   @unique
  kind       String
  entityKey  String   @map("entity_key")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  data       Json
  coverage   String   @default("verified")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([kind, occurredAt])
  @@index([kind, entityKey, occurredAt])
  @@map("data_center_records")
}

model DataCenterEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String   @unique
  provider      String
  type          String
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken    String?  @map("lease_token")
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("data_center_events")
}

model DataCenterProjection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("data_center_projections")
}

model DataCenterJob {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                  String   @unique
  kind                 String
  checkpoint           Json     @default("{}")
  status               String   @default("PENDING")
  attempts             Int      @default(0)
  nextAttemptAt        DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken           String?  @map("lease_token")
  leaseUntil           DateTime? @map("lease_until") @db.Timestamptz(3)
  lastError            String?  @map("last_error")
  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("data_center_jobs")
}

model GscKeywordSync {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteUrl        String    @map("site_url")
  status         String    @default("IDLE")
  syncToken      String?   @map("sync_token") @db.Uuid
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(3)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(3)
  latestDate     DateTime? @map("latest_date") @db.Date

  @@unique([accountId, siteUrl])
  @@map("gsc_keyword_syncs")
}

model GscKeywordDay {
  id            String    @id @default(uuid()) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteUrl       String    @map("site_url")
  date          DateTime  @db.Date
  fetchedAt     DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  keywordCount  Int       @map("keyword_count")
  impressions   Float
  positionSum   Float     @map("position_sum")
  limited       Boolean   @default(false)
  rows          GscKeywordDaily[]

  @@unique([accountId, siteUrl, date])
  @@map("gsc_keyword_days")
}

model GscKeywordDaily {
  id            String        @id @default(uuid()) @db.Uuid
  dayId         String        @map("day_id") @db.Uuid
  day           GscKeywordDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  queryHash     String        @map("query_hash") @db.Char(64)
  query         String
  clicks        Float
  impressions   Float
  // Keep unrounded position * impressions for correct multi-day aggregation.
  positionSum   Float         @map("position_sum")

  @@unique([dayId, queryHash])
  @@index([queryHash, dayId])
  @@map("gsc_keyword_daily")
}

// One-to-one with Account. Tracks the AI-generated site for accounts that
// onboarded via the "I don't have a website yet" path (onboardingPath = NEEDS_WEBSITE).
model GeneratedWebsite {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @unique @map("account_id") @db.Uuid
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // PENDING: brief not yet submitted for generation
  // GENERATING: Cloud Run Job dispatched, awaiting callback
  // BUILT: build succeeded, preview available
  // FAILED: build failed, see lastError
  status                String    @default("PENDING") @map("status")

  // Structured interview answers (business, offerings, audience/competitors, brand/contact)
  // — same shape as the mockup's `form` state. Also the input re-sent on regeneration.
  contentConfig         Json      @map("content_config")

  // URL slug for sites.igeo.ai/{slug} — unique across all generated sites.
  slug                  String?   @unique @map("slug")

  templateVersion       String?   @map("template_version")
  sourceGcsPath         String?   @map("source_gcs_path")
  buildGcsPath          String?   @map("build_gcs_path")
  previewUrl            String?   @map("preview_url")
  cloudRunJobExecutionId String?  @map("cloud_run_job_execution_id")
  buildLogsGcsKey       String?   @map("build_logs_gcs_key")
  lastError             String?   @map("last_error")

  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  editSessions          WebsiteEditSession[]

  @@map("generated_websites")
}

// Tracks a purchased-through-us domain end to end: registration, DNS zone,
// TLS certificate, and load balancer routing — see DomainProvisioningService.
model DomainOrder {
  id                        String    @id @default(uuid()) @db.Uuid
  accountId                 String    @map("account_id") @db.Uuid
  account                   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  domain                    String    @map("domain")
  registrar                 String    @default("GCP_CLOUD_DOMAINS") @map("registrar")

  // PENDING -> PURCHASED -> DNS_ZONE_CREATED -> CERT_PENDING -> LIVE (or FAILED at any step)
  status                    String    @default("PENDING") @map("status")

  purchasePriceCents        Int?      @map("purchase_price_cents")
  renewalPriceCents         Int?      @map("renewal_price_cents")
  years                     Int       @default(1) @map("years")
  autoRenew                 Boolean   @default(true) @map("auto_renew")
  registrantContact         Json?     @map("registrant_contact")

  gcpRegistrationId         String?   @map("gcp_registration_id")
  cloudDnsZoneId            String?   @map("cloud_dns_zone_id")
  certificateManagerCertId  String?   @map("certificate_manager_cert_id")
  certificateMapEntryId     String?   @map("certificate_map_entry_id")

  stripeInvoiceItemId       String?   @map("stripe_invoice_item_id")
  lastError                 String?   @map("last_error")
  purchasedAt               DateTime? @map("purchased_at") @db.Timestamptz(3)
  expiresAt                 DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([accountId])
  @@map("domain_orders")
}

// Chat-based "edit my generated site with AI" session (post-launch, dashboard-level).
model WebsiteEditSession {
  id                  String            @id @default(uuid()) @db.Uuid
  accountId           String            @map("account_id") @db.Uuid
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  generatedWebsiteId  String            @map("generated_website_id") @db.Uuid
  generatedWebsite    GeneratedWebsite  @relation(fields: [generatedWebsiteId], references: [id], onDelete: Cascade)

  // IDLE: ready for next message | EDITING: a Cloud Run Job is running | FAILED: last turn errored
  status              String            @default("IDLE") @map("status")

  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages            WebsiteEditMessage[]

  @@index([accountId])
  @@map("website_edit_sessions")
}

model WebsiteEditMessage {
  id                    String              @id @default(uuid()) @db.Uuid
  sessionId             String              @map("session_id") @db.Uuid
  session               WebsiteEditSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role                  String              @map("role") // 'USER' | 'ASSISTANT'
  content               String              @map("content")
  diffSummary           String?             @map("diff_summary")
  resultingBuildGcsPath String?             @map("resulting_build_gcs_path")

  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sessionId])
  @@map("website_edit_messages")
}

/// Parallel Content Studio workflow. This intentionally does not relate to the
/// legacy `post` model so the existing agent generation flow remains isolated.
model ContentWorkflow {
  id                String                       @id @default(uuid()) @db.Uuid
  accountId         String                       @map("account_id") @db.Uuid
  recommendationId String? @map("recommendation_id") @db.Uuid
  recommendationVersionId String? @unique @map("recommendation_version_id") @db.Uuid
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  recommendationVersion RecommendationVersion? @relation(fields: [recommendationVersionId], references: [id], onDelete: SetNull)
  templateId        String                       @map("template_id")
  destination       String                       @default("ONSITE")
  status            String                       @default("DRAFT")
  currentStage      String                       @default("CONFIGURATION") @map("current_stage")
  topicId           String?                      @map("topic_id") @db.Uuid
  promptIds         String[]                     @default([]) @map("prompt_ids") @db.Uuid
  platforms         String[]                     @default([])
  citedPageIds      String[]                     @default([]) @map("cited_page_ids")
  brandKit          Json?                        @map("brand_kit")
  audience          String?
  instructions      String?
  selectedTitle     String?                      @map("selected_title")
  selectedTitleKind String?                      @map("selected_title_kind")
  title             String?
  createdBy         String?                      @map("created_by") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  runs              ContentGenerationRun[]
  brief             ContentBrief?
  assets            ContentAsset[]

  @@index([accountId, updatedAt])
  @@index([accountId, status])
  @@map("content_workflows")
}

model ContentGenerationRun {
  id              String          @id @default(uuid()) @db.Uuid
  workflowId      String          @map("workflow_id") @db.Uuid
  workflow        ContentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  kind            String
  status          String          @default("PENDING")
  currentStep     Int             @default(0) @map("current_step")
  generationIndex Int             @default(1) @map("generation_index")
  inputsHash      String          @map("inputs_hash")
  model           String?
  promptVersion   String?         @map("prompt_version")
  output          Json?
  error           String?
  durationMs      Int?            @map("duration_ms")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workflowId, createdAt])
  @@index([inputsHash, createdAt])
  @@map("content_generation_runs")
}

model ContentBrief {
  id         String          @id @default(uuid()) @db.Uuid
  workflowId String          @unique @map("workflow_id") @db.Uuid
  workflow   ContentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outline    Json
  sections   Json
  metadata   Json?
  version    Int             @default(1)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("content_briefs")
}

model ContentAsset {
  recommendationVersionId String? @map("recommendation_version_id") @db.Uuid
  id              String          @id @default(uuid()) @db.Uuid
  workflowId      String          @map("workflow_id") @db.Uuid
  workflow        ContentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  bodyHtml        String          @map("body_html")
  focusKeyword    String?         @map("focus_keyword")
  slug            String?
  metaTitle       String?         @map("meta_title")
  metaDescription String?         @map("meta_description")
  tags            String[]        @default([])
  schemaJsonLd    Json?           @map("schema_json_ld")
  version         Int             @default(1)
  publishedUrl    String?         @map("published_url")
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workflowId, version])
  @@index([workflowId, createdAt])
  @@map("content_assets")
}

model AccountSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  accountId                 String   @unique @map("account_id") @db.Uuid
  scanPeriod                Int?     @map("scan_period")
  aiEngines                 Json[]   @map("ai_engines")
  regions                   String[] @map("regions")
  competitorsNames          Json     @map("competitors_names")
  suggestedCompetitorsNames Json?    @map("suggested_competitors_names")
  pixelId                   String?  @map("pixel_id")
  scanScheduleTime          String?  @map("scan_schedule_time")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  watchedOnboardVideo        DateTime? @map("watched_onboard_video")
  visitedSetupSteps         Json?    @map("visited_setup_steps")
  promptLimit               Int?     @map("prompt_limit")
  regionLimit               Int?     @map("region_limit")
  membersLimit              Int?     @default(2) @map("members_limit")
  scanIntervalLimit         Int?     @map("scan_interval_limit")
  stripeCustomerId          String?  @unique @map("stripe_customer_id")
  payingCustomer            String?  @map("paying_customer")
  socialMediaProviderTokens Json?    @map("social_media_provider_tokens")
  postCreationLimit         Int?     @map("post_creation_limit")
  referralCode              String?  @map("referral_code")
  whiteLabelLogoSmall       String?  @map("white_label_logo_small")
  whiteLabelLogoBig         String?  @map("white_label_logo_big")
  insightLimit              Int?     @default(0) @map("insight_limit")
  generateWeeklyInsights    Boolean  @default(false) @map("generate_weekly_insights")
  dailyRecommendationMode   String   @default("OFF") @map("daily_recommendation_mode")
  automatedPublishPosts      Json?    @map("automated_publish_posts")
  notificationPreferences   Json?    @map("notification_preferences")
  appSumoPlanTier           Int?     @map("appsumo_plan_tier")
  appSumoPlan               AppSumoPlan? @relation(fields: [appSumoPlanTier], references: [tier], onDelete: SetNull)
  mcpEnabled                Boolean  @default(false) @map("mcp_enabled")
  customBrandStyleEnabled   Boolean  @default(false) @map("custom_brand_style_enabled")
  apiAccessEnabled          Boolean  @default(false) @map("api_access_enabled")
  siteAuditEnabled          Boolean  @default(false) @map("site_audit_enabled")
  ssoSamlSoc2Enabled        Boolean  @default(false) @map("sso_saml_soc2_enabled")
  crmLead                   Json?    @map("crm_lead")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([appSumoPlanTier])
  @@map("account_settings")
}

/// Zernio permits one connected account per platform per profile, and connecting
/// a second account into an occupied slot silently replaces the first. Profiles
/// are therefore owner-scoped: one BRAND profile per workspace for publishable
/// channels, plus one MEMBER profile per teammate for their personal accounts.
model ZernioProfile {
  id               String   @id @default(uuid()) @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  zernioProfileId  String   @unique @map("zernio_profile_id")
  /// BRAND | MEMBER
  kind             String   @default("BRAND")
  /// Set only when kind is MEMBER. Owning teammate's user id.
  ownerUserId      String?  @map("owner_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account     Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerUser   User?                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connections ZernioSocialConnection[]

  // Uniqueness is enforced by partial indexes in the migration, because
  // Postgres treats NULL owner_user_id values as distinct:
  //   zernio_profiles_brand_unique  ON (account_id)                WHERE kind = 'BRAND'
  //   zernio_profiles_member_unique ON (account_id, owner_user_id) WHERE kind = 'MEMBER'
  @@index([accountId, kind])
  @@index([ownerUserId])
  @@map("zernio_profiles")
}

model ZernioSocialConnection {
  contentMentionReads ContentMentionRead[]
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.Uuid
  zernioProfileRecordId String    @map("zernio_profile_record_id") @db.Uuid
  provider              String
  zernioAccountId       String    @unique @map("zernio_account_id")
  externalAccountId     String?   @map("external_account_id")
  username              String?
  displayName           String?   @map("display_name")
  profileImage          String?   @map("profile_image")
  status                String    @default("CONNECTED")
  /// SCHEDULING (brand channel: publish + analytics) | ENGAGEMENT (teammate's
  /// personal account: like, comment and repost only)
  kind                  String    @default("SCHEDULING")
  /// Set only when kind is ENGAGEMENT. Owning teammate's user id.
  ownerUserId           String?   @map("owner_user_id") @db.Uuid
  isDefault             Boolean   @default(false) @map("is_default")
  metadata              Json?
  lastSyncedAt          DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile   ZernioProfile @relation(fields: [zernioProfileRecordId], references: [id], onDelete: Cascade)
  ownerUser User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  publisherConnectionId String? @map("publisher_connection_id") @db.Uuid
  engagementActions String[] @default([]) @map("engagement_actions")
  engagementNextAt DateTime? @map("engagement_next_at") @db.Timestamptz(3)
  publisher ZernioSocialConnection? @relation("PublisherEngagements", fields: [publisherConnectionId], references: [id], onDelete: SetNull)
  engagementProfiles ZernioSocialConnection[] @relation("PublisherEngagements")

  linkedInEngagements LinkedInEngagement[]
  socialEngagements   SocialEngagement[]

  @@index([accountId, publisherConnectionId])

  // One CONNECTED account per provider per profile is enforced by a partial
  // index in the migration, mirroring Zernio's own slot rule so the silent
  // replace-and-lose-history case fails loudly instead:
  //   zernio_conn_slot_unique ON (zernio_profile_record_id, provider) WHERE status = 'CONNECTED'
  @@unique([accountId, provider, zernioAccountId])
  @@index([accountId, provider, status])
  @@index([accountId, provider, isDefault])
  @@index([accountId, kind, status])
  @@index([ownerUserId])
  @@map("zernio_social_connections")
}

