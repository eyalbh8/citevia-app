/// Cost evidence deliberately has no Account foreign keys: deletion must not erase spend.
model OpsRun {
  id String @id @db.Uuid
  parentId String? @db.Uuid
  accountId String? @db.Uuid
  projectId String? @db.Uuid
  billingOwnerId String? @db.Uuid
  process String
  environment String
  region String
  sourceId String?
  status String @default("RUNNING")
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  heartbeatAt DateTime @default(now()) @db.Timestamptz(3)
  deadlineAt DateTime @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  outputs Int @default(0)
  errorCode String?
  @@index([startedAt, environment, process])
  @@index([projectId, startedAt])
  @@index([status, deadlineAt])
  @@map("ops_runs")
}

