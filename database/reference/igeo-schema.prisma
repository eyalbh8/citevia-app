  accountId   String?   @map("account_id") @db.Uuid
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId      String?   @map("user_id") @db.Uuid
  keyPrefix   String?   @map("key_prefix") @db.VarChar(32)

  httpMethod    String  @map("http_method") @db.VarChar(16)
  jsonRpcMethod String? @map("json_rpc_method") @db.VarChar(64)
  toolName      String? @map("tool_name") @db.VarChar(128)
  resourceUri   String? @map("resource_uri") @db.Text
  resolvedPath  String? @map("resolved_path") @db.Text

  requestParams Json? @map("request_params")

  outcome       String  @map("outcome") @db.VarChar(32)
  blockedReason String? @map("blocked_reason") @db.VarChar(64)
  errorMessage  String? @map("error_message") @db.Text

  durationMs         Int? @map("duration_ms")
  upstreamHttpStatus Int? @map("upstream_http_status")
  responseBytes      Int? @map("response_bytes")
  recordCount        Int? @map("record_count")

  clientIp          String? @map("client_ip") @db.VarChar(128)
  requestOrigin     String? @map("request_origin") @db.VarChar(512)
  referer           String? @map("referer") @db.VarChar(1024)
  userAgent         String? @map("user_agent") @db.VarChar(1024)
  inferredMcpClient String? @map("inferred_mcp_client") @db.VarChar(32)

  @@index([accountId, createdAt])
  @@index([mcpApiKeyId, createdAt])
  @@index([inferredMcpClient, createdAt])
  @@map("mcp_audit_logs")
}

/// OAuth 2.1 dynamic client registration (MCP / Claude connectors)
model OAuthClient {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @unique @map("client_id") @db.VarChar(128)
  clientSecretHash   String?  @map("client_secret_hash") @db.VarChar(64)
