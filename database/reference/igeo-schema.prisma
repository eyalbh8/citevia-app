  @@index([sessionId, createdAt])
  @@map("ai_assistant_messages")
}

model ReleaseAnnouncement {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  version     String?
  state       String   @default("DRAFT")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  slides ReleaseAnnouncementSlide[]
  views  UserAnnouncementView[]

  @@index([state, publishedAt])
  @@map("release_announcements")
}

model ReleaseAnnouncementSlide {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  sortOrder      Int      @map("sort_order")
  title          String
  description    String   @db.Text
  imageUrl       String?  @map("image_url")
  ctaLabel       String?  @map("cta_label")
  ctaUrl         String?  @map("cta_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  announcement ReleaseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, sortOrder])
  @@index([announcementId])
  @@map("release_announcement_slides")
}

model UserAnnouncementView {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  completedAt    DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement ReleaseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@map("user_announcement_views")
}

/// OFF/SHADOW/ENABLED is configured per account. Runs never debit content credits.
model RecommendationRun {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectAccountId String @map("project_account_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  evidenceCutoff DateTime @map("evidence_cutoff") @db.Timestamptz(3)
  engineVersion String @map("engine_version")
  mode String
  status String @default("PENDING")
  attempts Int @default(0)
  refreshAttempts Int @default(0) @map("refresh_attempts")
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  inputHash String? @map("input_hash")
  packet Json?
  synthesis Json?
  coverage Json?
  usage Json?
  budgetReserved Boolean @default(false) @map("budget_reserved")
  error String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  versions RecommendationVersion[]

  @@unique([accountId, windowStart, engineVersion])
  @@index([status, leaseUntil])
  @@map("recommendation_runs")
}

model RecommendationProjectBudget {
  id String @id @default(uuid()) @db.Uuid
  projectAccountId String @map("project_account_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  reservedUrls Int @default(0) @map("reserved_urls")
  reservedCandidates Int @default(0) @map("reserved_candidates")
  reservedCalls Int @default(0) @map("reserved_calls")

  @@unique([projectAccountId, windowStart])
  @@map("recommendation_project_budgets")
}

/// Canonical identity is independent of the existing generated/RAG corpus.
model RecommendationEvidenceSource {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceKey String @map("source_key")
  url String?
  kind String
  lastCheckedAt DateTime @map("last_checked_at") @db.Timestamptz(3)
  lastFetchStatus String @map("last_fetch_status")
  currentContentHash String? @map("current_content_hash")
  snapshots RecommendationEvidenceSnapshot[]

  @@unique([accountId, sourceKey])
  @@map("recommendation_evidence_sources")
}

model RecommendationEvidenceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @map("source_id") @db.Uuid
  source RecommendationEvidenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  contentHash String @map("content_hash")
  observedAt DateTime @map("observed_at") @db.Timestamptz(3)
  content Json

  @@unique([sourceId, contentHash])
  @@map("recommendation_evidence_snapshots")
}

model RecommendationVersion {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  recommendationId String @map("recommendation_id") @db.Uuid
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  runId String? @map("run_id") @db.Uuid
  run RecommendationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  inputHash String @map("input_hash")
  payload Json
  evidence Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  workflow ContentWorkflow?

  @@unique([recommendationId, inputHash])
  @@index([accountId, createdAt])
  @@map("recommendation_versions")
}


model ContentDeliveryJob {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  recipientUserId String? @map("recipient_user_id") @db.Uuid
  postId String? @map("post_id") @db.Uuid
  notificationId String? @map("notification_id") @db.Uuid
  dedupeKey String @unique @map("dedupe_key")
  channel String
  targetId String? @map("target_id")
  payload Json
  status String @default("PENDING")
