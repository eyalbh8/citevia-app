/// Multi-provider engagement ledger and durable automation jobs.
model SocialEngagement {
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken String? @map("lease_token")
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  connectionId String    @map("connection_id") @db.Uuid
  provider     String
