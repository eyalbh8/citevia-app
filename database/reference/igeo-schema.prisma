/// Records a system admin reaching an account they are not a member of.
///
/// Admins bypass AccountMemberGuard entirely, so without this there is no trace
/// of staff opening customer data — the control a SOC2 reviewer asks for.
/// Written fire-and-forget: an audit failure must never block the request, but
/// it is logged at error level so silent loss is visible.
model AdminAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userId    String  @map("user_id") @db.Uuid
  userEmail String  @map("user_email")
  /// The account reached. Kept as a plain column (no FK) so the trail survives
  /// the account being deleted — an audit record that vanishes with its subject
  /// is not an audit record.
  accountId String  @map("account_id") @db.Uuid
  /// The project it belongs to, so access can be reviewed per customer.
  projectAccountId String? @map("project_account_id") @db.Uuid
  /// True when accountId is a workspace rather than a project.
  isWorkspace Boolean @default(false) @map("is_workspace")

  method String @db.VarChar(16)
  path   String @db.Text

  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([projectAccountId])
  @@map("admin_access_logs")
}

model McpAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  mcpApiKeyId String?   @map("mcp_api_key_id") @db.Uuid
