/// Ledger of engagement actions performed on LinkedIn by connected accounts.
/// Zernio exposes no per-account "did this account like that post" read for
/// third-party posts, so amplification state is tracked here.
model LinkedInEngagement {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  connectionId String    @map("connection_id") @db.Uuid
  /// LinkedIn post URN, or the Zernio post id when acting on our own post.
  targetUrn    String    @map("target_urn")
  /// OWN_POST | SOURCE_POST
  targetKind   String    @map("target_kind")
  /// LIKE | COMMENT | REPOST
  action       String
  /// PENDING | DONE | FAILED
  status       String    @default("PENDING")
  reactionType String?   @map("reaction_type")
  message      String?
  /// Comment URN or reaction id returned by Zernio.
  externalId   String?   @map("external_id")
  errorCode    String?   @map("error_code")
  error        String?
  /// Our own `post` row when targetKind is OWN_POST.
  postId       String?   @map("post_id") @db.Uuid
  performedAt  DateTime? @map("performed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account    Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  connection ZernioSocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, targetUrn, action])
  @@index([accountId, targetUrn])
  @@index([accountId, targetKind, status])
  @@map("linkedin_engagements")
}

