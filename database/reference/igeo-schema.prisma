  postId       String?   @map("post_id") @db.Uuid
  /// Native platform post id / URN / Zernio post id used for the API call.
  targetPostId String    @map("target_post_id")
  /// LIKE | COMMENT | REPOST
  action       String
  /// PENDING | RUNNING | RETRY | RETRY_SUBMISSION | SUBMITTED | DONE | FAILED | SKIPPED | REVIEW_REQUIRED
