# Copy to .env and configure all three providers for account creation and scans.
# Without credentials the app starts empty; it never substitutes sample data.
# Never put secrets in VITE_* variables.
OPENAI_API_KEY=
# Alternatively set OPENAI_SECRET_ARN to an AWS Secrets Manager secret containing
# a raw API key or JSON {"OPENAI_API_KEY":"..."}; see scanner provider for formats.
OPENAI_SECRET_ARN=
# Server-only photos for all agent posts; never expose the key through VITE_*.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_ARN=
AWS_REGION=eu-central-1
OPENAI_GENERATION_MODEL=gpt-4.1-2025-04-14
# Stronger model for agent content creation only; visibility scans keep their own model.
OPENAI_CONTENT_MODEL=gpt-6-astra
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_ONBOARDING_MODEL=gpt-4.1-2025-04-14
# Native Perplexity Agent API and Gemini API collections (server only).
# Secret values may be raw keys or JSON with the corresponding *_API_KEY field.
PERPLEXITY_API_KEY=
PERPLEXITY_SECRET_ARN=
PERPLEXITY_PRESET=fast@2026-10-16.0
GEMINI_API_KEY=
GEMINI_SECRET_ARN=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
# Optional remote PostgreSQL for operator scripts. Local dev uses embedded PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/citevia
# Initial model candidates: verify access/quality/cost with scan:spike before production.

# Optional local database/evidence directory. Default is .local-data/real.
# LOCAL_DATA_DIR=.local-data/real

# Descope is required for both local and AWS authentication. No local login bypass.
# Project ID is public; management key is server-only and used for user lookups.
DESCOPE_PROJECT_ID=
DESCOPE_FLOW_ID=sign-in
DESCOPE_BASE_URL=https://api.descope.com
DESCOPE_MANAGEMENT_KEY=
# Alternative to a direct key: raw key or JSON {"DESCOPE_MANAGEMENT_KEY":"..."}.
DESCOPE_SECRET_ARN=

# Optional public Logo.dev image key (pk_...), forwarded to Vite by npm run dev.
# Without it, domain logos use Google favicons, then initials. Never use a secret sk_ key.
VITE_LOGO_DEV_API_KEY=
# Public origins for MCP discovery and OAuth consent. Defaults work with npm run dev.
# Production sets these from the deployment's API hostname and FrontendOrigin.
MCP_PUBLIC_URL=http://127.0.0.1:3001
ALLOWED_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated browser origins; native MCP clients send no Origin.
MCP_ALLOWED_ORIGINS=
