# Copy to .env and configure all three providers for account creation and scans.
# Without credentials the app starts empty; it never substitutes sample data.
# Never put secrets in VITE_* variables.
OPENAI_API_KEY=
# Alternatively set OPENAI_SECRET_ARN to an AWS Secrets Manager secret containing
# a raw API key or JSON {"OPENAI_API_KEY":"..."}; see scanner provider for formats.
OPENAI_SECRET_ARN=
# Server-only photos for all agent posts; never expose the key through VITE_*.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_ARN=
# Website Health: enable PageSpeed Insights API and Chrome UX Report API in Google Cloud.
# Keys are server-only. The same restricted Google key may be configured for both APIs.
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_PAGESPEED_SECRET_ARN=
GOOGLE_CRUX_API_KEY=
GOOGLE_CRUX_SECRET_ARN=
AWS_REGION=eu-central-1
OPENAI_GENERATION_MODEL=gpt-4.1-2025-04-14
# Stronger model for agent content creation only; visibility scans keep their own model.
OPENAI_CONTENT_MODEL=gpt-6-astra
ANALYSIS_MODEL=gemini-3.8-flash
# Legacy OPENAI_EXTRACTION_MODEL remains an explicit override when ANALYSIS_MODEL is unset.
# Optional single validation-only fallback; never used after an uncertain network call.
ANALYSIS_FALLBACK_MODEL=
# Legacy OPENAI_EXTRACTION_FALLBACK_MODEL remains supported when this setting is unset.
# Native OpenAI Batch applies only to scheduled runs pinned to an OpenAI analysis model.
# Gemini analysis is realtime. Existing OpenAI batches continue to finish/import.
ANALYSIS_BATCH_ENABLED=false
ANALYSIS_CACHE_ENABLED=true
# Shared production scanner pacing across workers, including analysis for all providers.
# Per-provider overrides: SCANNER_OPENAI_*, SCANNER_GEMINI_*, SCANNER_PERPLEXITY_*.
SCANNER_PROVIDER_MIN_INTERVAL_MS=10000
SCANNER_PROVIDER_MAX_CONCURRENT=2
# Durable fair dispatcher caps queued + executing prompt work across all scanner workers.
SCAN_DISPATCH_MAX_OUTSTANDING=12
SCAN_DISPATCH_MAX_PER_ACCOUNT=3
SCAN_DISPATCH_MAX_PER_PROVIDER=4
# Optional monthly estimated provider budget per account (UTC calendar month); 0 disables.
# Unknown models are recorded as unpriced; configure their rates before enabling a budget.
LLM_MONTHLY_BUDGET_USD=0
# Optional JSON provider -> model -> {input,output,cachedInput?,cacheWrite?,search?}.
# Token prices are USD/1M; search price is USD/call. Costs are estimates, not invoices.
LLM_MODEL_PRICES_JSON=
# Existing account model settings stay pinned; see docs/COST_OPTIMIZATION.md for rollout.
# Enable only when an external consumer still needs the inherited results projection.
CITEVIA_WRITE_COMPATIBILITY_RESULTS=false
# Local/new-version-only workers can compact state immediately. First production
# rollout keeps this false until all pre-optimization workers have drained.
CITEVIA_COMPACT_RUN_STATE=true
OPENAI_ONBOARDING_MODEL=gpt-4.1-2025-04-14
# Native Perplexity Agent API and Gemini API collections (server only).
# Secret values may be raw keys or JSON with the corresponding *_API_KEY field.
PERPLEXITY_API_KEY=
PERPLEXITY_SECRET_ARN=
PERPLEXITY_PRESET=fast@2026-10-16.0
GEMINI_API_KEY=
GEMINI_SECRET_ARN=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
# Optional remote PostgreSQL for operator scripts. Local dev uses embedded PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/citevia
# AWS external PostgreSQL uses DatabaseMode=external and an ExternalDatabaseSecretArn
# containing host, port, database, username and password JSON; keep credentials out of env.
# CITEVIA_MAINTENANCE_MODE=true pauses API/scanner writers during a coordinated migration.
# Initial model candidates: verify access/quality/cost with scan:spike before production.

# Optional local database/evidence directory. Default is .local-data/real.
# LOCAL_DATA_DIR=.local-data/real

# Descope is required for both local and AWS authentication. No local login bypass.
# Project ID is public; management key is server-only and used for user lookups.
DESCOPE_PROJECT_ID=
DESCOPE_FLOW_ID=sign-in
DESCOPE_BASE_URL=https://api.descope.com
DESCOPE_MANAGEMENT_KEY=
# Alternative to a direct key: raw key or JSON {"DESCOPE_MANAGEMENT_KEY":"..."}.
DESCOPE_SECRET_ARN=

# Optional public Logo.dev image key (pk_...), forwarded to Vite by npm run dev.
# Without it, domain logos use Google favicons, then initials. Never use a secret sk_ key.
VITE_LOGO_DEV_API_KEY=
# Public origins for MCP discovery and OAuth consent. Defaults work with npm run dev.
# Production sets these from the deployment's API hostname and FrontendOrigin.
MCP_PUBLIC_URL=http://127.0.0.1:3001
ALLOWED_ORIGIN=http://127.0.0.1:5173
# Optional comma-separated browser origins; native MCP clients send no Origin.
MCP_ALLOWED_ORIGINS=
