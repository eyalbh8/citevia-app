{
  "name": "citevia-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:live": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @citevia/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/build.mjs && npm run build --workspace @citevia/client",
    "bootstrap": "node --env-file-if-exists=.env --import tsx scripts/admin-bootstrap.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/admin-bootstrap.ts",
    "scan:spike": "node --env-file-if-exists=.env --import tsx scripts/spike.ts",
    "tracking:backfill": "node --env-file-if-exists=.env --import tsx scripts/backfill-tracking.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.900.0",
    "@aws-sdk/client-lambda": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-scheduler": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@descope/node-sdk": "^2.20.0",
    "@electric-sql/pglite": "^0.5.10",
    "pg": "^8.23.1",
    "tldts": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "yaml": "^2.8.0"
  }
}
