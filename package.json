{
  "name": "citevia-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "demo:nayax": "node --env-file-if-exists=.env --import tsx scripts/create-nayax-demo.ts",
    "demo:dr-roof": "node --env-file-if-exists=.env --import tsx scripts/create-dr-roof-demo.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:live": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @citevia/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && node scripts/build.mjs && npm run build --workspace @citevia/client",
    "bootstrap": "node --env-file-if-exists=.env --import tsx scripts/admin-bootstrap.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/admin-bootstrap.ts",
    "scan:spike": "node --env-file-if-exists=.env --import tsx scripts/spike.ts",
    "scanner:providers": "node --env-file-if-exists=.env --import tsx scripts/scanner-provider-status.ts",
    "schedules:configure": "node --env-file-if-exists=.env --import tsx scripts/configure-schedules.ts",
    "tracking:backfill": "node --env-file-if-exists=.env --import tsx scripts/backfill-tracking.ts",
    "analysis:eval": "node --env-file-if-exists=.env --import tsx scripts/evaluate-analysis.ts",
    "analysis:configure": "node --env-file-if-exists=.env --import tsx scripts/configure-analysis.ts",
    "costs:report": "node --env-file-if-exists=.env --import tsx scripts/provider-costs.ts",
    "db:audit": "node --env-file-if-exists=.env --import tsx scripts/database-maintenance.ts audit",
    "db:cleanup-auth": "node --env-file-if-exists=.env --import tsx scripts/database-maintenance.ts cleanup-auth",
    "db:compact-evidence": "node --env-file-if-exists=.env --import tsx scripts/database-maintenance.ts compact-evidence",
    "db:rehydrate-runs": "node --env-file-if-exists=.env --import tsx scripts/database-maintenance.ts rehydrate-run-manifests",
    "db:neon-migration": "node --env-file-if-exists=.env --import tsx scripts/neon-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.900.0",
    "@aws-sdk/client-lambda": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-scheduler": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@descope/node-sdk": "^2.20.0",
    "@electric-sql/pglite": "^0.5.10",
    "geoip-country": "^5.0.202610210158",
    "pg": "^8.23.1",
    "tldts": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "geoip-country": {
      "ip-address": "^10.7.4"
    }
  }
}
