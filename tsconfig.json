{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node"], "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts", "apps/scanner/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
