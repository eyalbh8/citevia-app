# Local development only: accepted exclusively on loopback hosts.
# The root `npm run dev` sets this automatically for the local demo.
VITE_AUTH_MODE=local

# Production uses Cognito. Remove VITE_AUTH_MODE and configure these values.
# VITE_API_URL=https://API_ID.execute-api.REGION.amazonaws.com/v1
# VITE_COGNITO_DOMAIN=https://YOUR_DOMAIN.auth.REGION.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=YOUR_PUBLIC_APP_CLIENT_ID
# VITE_REDIRECT_URI=https://APP_DOMAIN/auth/callback
# VITE_LOGOUT_URI=https://APP_DOMAIN/
