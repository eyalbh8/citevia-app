# Public client settings only. Never put management keys or OpenAI keys here.
# Root npm run dev supplies these from the root Descope variables.
VITE_API_URL=/api/v1
VITE_DESCOPE_PROJECT_ID=
VITE_DESCOPE_FLOW_ID=sign-in
VITE_DESCOPE_BASE_URL=https://api.descope.com
# For a hosted build, VITE_API_URL is the API stack output with /v1 appended.
